{
  "opencollection": "1.0.0",
  "info": {
    "name": "Fuse Accounts Oauth API",
    "version": "0.1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Oauth",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get a bearer token",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.fuse.me/oauth/token",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "This API is designed to issue a bearer token for a valid user. The API will accept a request containing the user's credentials and return a response containing a bearer token."
        }
      ]
    }
  ],
  "bundled": true
}
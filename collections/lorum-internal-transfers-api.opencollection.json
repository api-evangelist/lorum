{
  "opencollection": "1.0.0",
  "info": {
    "name": "Fuse Accounts Internal Transfers API",
    "version": "0.1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Internal Transfers",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Move funds between two accounts with the same currency",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.fuse.me/v1/internal-transfers",
            "headers": [
              {
                "name": "Idempotency-Key",
                "value": ""
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Move funds between two accounts with the same currency"
        }
      ]
    }
  ],
  "bundled": true
}